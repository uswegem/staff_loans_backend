{
  "openapi": "3.0.3",
  "info": {
    "title": "LFB Staff Loan Application System (SLAS) API",
    "version": "0.1.0",
    "description": "REST JSON API for SLAS. Requirement IDs refer to BRD v0.8. Responses use { success, data } or { success: false, code, message, details }."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users with roles, MFA and lock status",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Page of users"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a user for an existing staff record with a temporary password",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "User detail with effective permissions",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "User"
          }
        }
      }
    },
    "/users/{id}/activate": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Activate",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}/deactivate": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Deactivate and end sessions",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}/unlock": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Unlock after failed attempts (audited)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}/reset-mfa": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Reset MFA; the user enrols again",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}/reset-password": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Issue a temporary password",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/{id}/roles": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Current role assignments",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Assignments"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Replace role assignments (SoD checked, FR-46, FR-48)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          },
          "409": {
            "description": "Segregation-of-duties conflict"
          }
        }
      }
    },
    "/permissions": {
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "Permission catalogue and SoD rules (FR-44)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Catalogue"
          }
        }
      }
    },
    "/roles": {
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "Roles with holder counts",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Roles"
          }
        }
      },
      "post": {
        "tags": [
          "Roles"
        ],
        "summary": "Create a custom role (FR-45)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "409": {
            "description": "SoD conflict"
          }
        }
      }
    },
    "/roles/{id}": {
      "patch": {
        "tags": [
          "Roles"
        ],
        "summary": "Rename, deactivate or change permissions (checked against every holder)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          },
          "409": {
            "description": "SoD conflict"
          }
        }
      },
      "delete": {
        "tags": [
          "Roles"
        ],
        "summary": "Delete a custom role nobody holds",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/roles/sod-check": {
      "post": {
        "tags": [
          "Roles"
        ],
        "summary": "Live segregation-of-duties check for the matrix",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Result"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with staff number and password (FR-53)",
        "description": "Returns a session, or an mfaToken when a one-time code (or enrolment) is needed. Failures return remainingAttempts; the 5th failure locks the account (423).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "staffNo",
                  "password"
                ],
                "properties": {
                  "staffNo": {
                    "type": "string",
                    "example": "LFB0412"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session opened",
            "or MFA step required": null
          },
          "401": {
            "description": "Wrong staff number or password",
            "with remainingAttempts": null
          },
          "423": {
            "description": "Account locked"
          }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Complete sign-in with a 6-digit TOTP code",
        "responses": {
          "200": {
            "description": "Session opened"
          }
        }
      }
    },
    "/auth/mfa/enrol/start": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Start authenticator enrolment (QR code)",
        "responses": {
          "200": {
            "description": "otpauth URI and QR data URL"
          }
        }
      }
    },
    "/auth/mfa/enrol/confirm": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Confirm enrolment with a first code and open the session",
        "responses": {
          "200": {
            "description": "Session opened"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate the refresh cookie and get a new access token",
        "parameters": [
          {
            "in": "header",
            "name": "X-XSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New access token"
          },
          "401": {
            "description": "Session ended"
          },
          "403": {
            "description": "CSRF rejected"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "End the current session",
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user, roles and permissions (FR-52)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change own password (policy Q2)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Changed"
          }
        }
      }
    },
    "/admin/settings": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Workflow targets, working calendar, holidays",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Settings"
          }
        }
      },
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Change workflow settings (audited)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved"
          }
        }
      }
    },
    "/admin/holidays": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Add a public holiday",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Added"
          }
        }
      }
    },
    "/admin/holidays/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Remove a public holiday",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          }
        }
      }
    },
    "/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "Read-only audit log with filters (RP-10)",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Entries"
          }
        }
      }
    }
  },
  "tags": []
}
