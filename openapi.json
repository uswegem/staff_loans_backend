  "info": {
    "title": "LFB Staff Loan Application System (SLAS) API",
    "version": "0.1.0",
    "description": "REST JSON API for SLAS. Requirement IDs refer to BRD v0.8. Responses use { success, data } or { success: false, code, message, details }."
