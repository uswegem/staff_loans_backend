    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with staff number and password (FR-53)",
        "description": "Returns a session, or an mfaToken when a one-time code (or enrolment) is needed. Failures return remainingAttempts; the 5th failure locks the account (423).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "staffNo",
                  "password"
                ],
                "properties": {
                  "staffNo": {
                    "type": "string",
                    "example": "LFB0412"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session opened",
            "or MFA step required": null
          },
          "401": {
            "description": "Wrong staff number or password",
            "with remainingAttempts": null
          },
          "423": {
            "description": "Account locked"
          }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "tags": [
