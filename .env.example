# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB 7+ running as a replica set (transactions). See README.
MONGODB_URI=mongodb://127.0.0.1:27017/slas?replicaSet=rs0

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 64 hex characters (32 bytes) for encrypting MFA secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENC_KEY=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=28800
MFA_TOKEN_TTL_SEC=300
# Keep true outside local http development; cookies are SameSite=Strict either way.
COOKIE_SECURE=true
# Only when the frontend is served from another origin (the Vite dev proxy makes this unnecessary).
CORS_ORIGIN=
TRUST_PROXY=loopback
LOGIN_RATE_LIMIT_PER_MIN=20
BCRYPT_ROUNDS=12
LOG_LEVEL=info
MFA_ISSUER=LFB Staff Loans
# Uploaded documents, outside the web root (milestone 4).
UPLOAD_DIR=C:\slas-data\uploads

# Seed only: password for every sample account (npm run seed).
SEED_PASSWORD=
